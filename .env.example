# Environment variables for AERIXA API

# Database
# Local: use DB_URL (JDBC format)
DB_URL=jdbc:postgresql://localhost:5432/aerixa_dev
# Render/Neon: provide DATABASE_URL in format postgresql://user:password@host/db?sslmode=require
DATABASE_URL=
# Optional when credentials are already embedded in DATABASE_URL
DB_USERNAME=aerixa_user
DB_PASSWORD=aerixa_password

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-change-in-prod

# Environment (dev, staging, prod)
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8080

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3003

# URLs applicatives
PORTAL_LOGIN_URL=http://localhost:3003/fr/login
EMAIL_VERIFICATION_BASE_URL=http://localhost:8080/api/v1/auth/verify-email?token=
PASSWORD_RESET_BASE_URL=http://localhost:3003/fr/reset-password?token=
OPERATOR_PASSWORD_SETUP_BASE_URL=http://localhost:3003/fr/reset-password?token=

# SMTP / Email
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_CONNECTION_TIMEOUT_MS=10000
MAIL_SMTP_TIMEOUT_MS=10000
MAIL_SMTP_WRITE_TIMEOUT_MS=10000
MAIL_FROM=no-reply@aerixa-app.com

# Notifications
NOTIF_MAIL_ENABLED=true
PASSWORD_RESET_FAIL_ON_EMAIL_ERROR=true
NOTIF_MAIL_RECIPIENT=
NOTIF_MAIL_STAGE_RECIPIENT=
NOTIF_WEBSOCKET_ENABLED=true

# Logging
LOGGING_LEVEL_ROOT=INFO

# Google OAuth SSO (only provider enabled)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ENABLED=true
GOOGLE_OAUTH_JIT_PROVISIONING=true
GOOGLE_OAUTH_DOMAIN_RESTRICTIONS=

# MFA (TOTP)
MFA_ENABLED=true
MFA_CHALLENGE_EXPIRY_SECONDS=300
MFA_TOTP_WINDOW=1
MFA_TOTP_ISSUER=AERIXA
MFA_ENCRYPTION_KEY=
